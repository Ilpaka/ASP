@page "/tasks"
@model SecureTodo.Pages.Tasks.IndexModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = "Задачи"; }
<section class="section-head"><div><div class="eyebrow">ВАШ РАБОЧИЙ ПРОЦЕСС</div><h1>@(User.IsInRole("Admin") ? "Все задачи" : "Мои задачи")</h1><p>@(User.IsInRole("Admin") ? "Просмотр и управление задачами всех пользователей." : "Здесь видны только созданные вами задачи.")</p></div><a class="button primary" asp-page="/Tasks/Create">＋ Новая задача</a></section>
<div class="task-summary"><span><i class="summary-dot"></i> Всего: <strong>@Model.Items.Count</strong></span><span><i class="summary-dot green"></i> Выполнено: <strong>@Model.Items.Count(x => x.IsCompleted)</strong></span></div>
@if (!Model.Items.Any()) { <div class="card empty-task"><div>▣</div><h2>Задач пока нет</h2><p>Создайте первую задачу, чтобы начать работу.</p></div> }
else { <div class="task-list">@foreach (var item in Model.Items) { var canEdit = (await AuthorizationService.AuthorizeAsync(User, item, "CanEditTask")).Succeeded; <article class="task-card" data-task-id="@item.Id"><span class="task-check @(item.IsCompleted ? "done" : "")">@(item.IsCompleted ? "✓" : "")</span><div class="task-main"><div class="task-top"><h2 class="@(item.IsCompleted ? "completed" : "")">@item.Title</h2><span class="task-status">@(item.IsCompleted ? "Готово" : "В работе")</span></div>@if (!string.IsNullOrWhiteSpace(item.Description)) { <p>@item.Description</p> }<div class="task-meta">@item.User.FullName · @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div></div>@if (canEdit) { <div class="task-actions">@if (!item.IsCompleted) { <button type="button" class="text-button complete-button" data-task-id="@item.Id">Отметить выполненной</button> }<a class="text-button" asp-page="/Tasks/Edit" asp-route-id="@item.Id">Редактировать</a><form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"><button type="submit" class="text-button danger">Удалить</button></form></div> }</article> }</div> }
