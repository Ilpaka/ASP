@page "/"
@model SecureTodo.Pages.IndexModel
@{ ViewData["Title"] = "Главная"; }
<section class="hero"><div class="hero-copy"><div class="eyebrow">ЗАДАЧИ ПОД ЗАЩИТОЙ</div><h1>Ваши планы.<br /><span>Ваши правила.</span></h1><p>Управляйте задачами с защищённым входом, ролями и контролем доступа. Все важные действия проходят проверку.</p><div class="hero-actions"><a class="button primary" asp-page="/Tasks/Index">Открыть задачи →</a>@if (User.Identity?.IsAuthenticated != true) { <a class="button ghost" asp-page="/Account/Register">Создать аккаунт</a> }</div></div><div class="hero-art"><div class="art-card"><span class="art-heading">Мой список задач</span><div><i class="check">✓</i> Запланировать неделю</div><div><i class="check">✓</i> Проверить проект</div><div><i class="circle"></i> Подготовить отчёт</div><div class="art-footer"><span>Защищено</span><strong>⌁ SecureTodo</strong></div></div></div></section>
<section class="dashboard-head"><div><div class="eyebrow">ОБЗОР</div><h2>Здравствуйте, @(User.Identity?.IsAuthenticated == true ? Model.DisplayName : "гость")</h2><p>@(User.Identity?.IsAuthenticated == true ? "Ваши задачи и данные доступны только вам и тем, кому разрешено." : "Войдите или зарегистрируйтесь, чтобы создавать задачи.")</p></div><span class="today-pill">@DateTime.Now.ToString("dd MMMM yyyy")</span></section>
<section class="stats-grid"><article class="stat-card"><span class="stat-icon purple">▣</span><div><strong>@Model.TotalTasks</strong><span>Задач всего</span></div></article><article class="stat-card"><span class="stat-icon green">✓</span><div><strong>@Model.CompletedTasks</strong><span>Выполнено</span></div></article><article class="stat-card"><span class="stat-icon blue">◉</span><div><strong>@Model.ActiveTasks</strong><span>В работе</span></div></article></section>
<section class="feature-grid"><div class="feature-card"><div class="feature-icon">🔒</div><h3>Контроль доступа</h3><p>Задачи могут редактировать их авторы и администраторы.</p></div><div class="feature-card"><div class="feature-icon">✦</div><h3>Двойная защита</h3><p>Включите код из приложения-аутентификатора в профиле.</p></div><div class="feature-card"><div class="feature-icon">↗</div><h3>API для интеграций</h3><p>JWT и обновляемые токены для безопасной работы с API.</p></div></section>
