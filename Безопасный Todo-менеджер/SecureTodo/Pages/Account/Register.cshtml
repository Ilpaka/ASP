@page "/account/register"
@model SecureTodo.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Регистрация"; }
<section class="auth-layout"><div class="auth-panel"><div class="eyebrow">НАЧНИТЕ РАБОТУ</div><h1>Создать аккаунт</h1><p>Зарегистрируйтесь, чтобы хранить и выполнять задачи.</p><form method="post" asp-page="/Account/Register"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Input.FullName">Ваше имя</label><input asp-for="Input.FullName" autocomplete="name" placeholder="Как к вам обращаться" /><span asp-validation-for="Input.FullName" class="validation"></span><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" type="email" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Input.Email" class="validation"></span><label asp-for="Input.Password">Пароль</label><input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="Не менее 6 символов и цифра" /><span asp-validation-for="Input.Password" class="validation"></span><label asp-for="Input.ConfirmPassword">Подтверждение пароля</label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="validation"></span><button class="button primary full" type="submit">Зарегистрироваться →</button></form><div class="auth-switch">Уже есть аккаунт? <a asp-page="/Account/Login">Войти</a></div></div><aside class="auth-side"><span>SECURE TODO</span><h2>Ваши задачи<br />под надёжной<br />защитой.</h2><p>Пароли хранятся в виде хешей. Доступ к изменению задач определяется ролью и владельцем.</p></aside></section>
