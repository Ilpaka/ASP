@page "/account/login"
@model SecureTodo.Pages.Account.LoginModel
@{ ViewData["Title"] = "Вход"; }
<section class="auth-layout"><div class="auth-panel"><div class="eyebrow">С ВОЗВРАЩЕНИЕМ</div><h1>Войти в аккаунт</h1><p>Продолжите работу со своими задачами.</p><form method="post" asp-page="/Account/Login"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" type="email" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Input.Email" class="validation"></span><label asp-for="Input.Password">Пароль</label><input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Ваш пароль" /><span asp-validation-for="Input.Password" class="validation"></span><button class="button primary full" type="submit">Войти →</button></form><div class="auth-switch">Ещё нет аккаунта? <a asp-page="/Account/Register">Зарегистрироваться</a></div></div><aside class="auth-side"><span>ВАШЕ ПРОСТРАНСТВО</span><h2>Порядок в делах.<br />Спокойствие<br />в деталях.</h2><p>Защищённый вход, роли и дополнительный код подтверждения.</p></aside></section>
