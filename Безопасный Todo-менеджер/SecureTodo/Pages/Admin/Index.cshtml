@page "/admin"
@model SecureTodo.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Админ-панель"; }
<section class="section-head"><div><div class="eyebrow">УПРАВЛЕНИЕ ДОСТУПОМ</div><h1>Пользователи и роли</h1><p>Роли меняются через защищённую форму. Администратора нельзя понизить.</p></div></section>
<div asp-validation-summary="ModelOnly" class="validation"></div><div class="card admin-card"><div class="admin-row admin-head"><span>Пользователь</span><span>Роль</span><span>Действие</span></div>@foreach (var user in Model.Users) { <div class="admin-row"><div class="admin-user"><span class="admin-avatar">@user.Email[..1].ToUpperInvariant()</span><div><strong>@user.FullName</strong><small>@user.Email</small></div></div><span class="role-badge">@user.Role</span>@if (user.Role == "Admin") { <span class="muted">Роль защищена</span> } else { <form method="post" asp-page-handler="ChangeRole" class="role-form"><input type="hidden" name="userId" value="@user.Id" /><select name="newRole" aria-label="Новая роль для @user.Email"><option value="User" selected="@(user.Role == "User")">User</option><option value="Author" selected="@(user.Role == "Author")">Author</option></select><button class="button small" type="submit">Применить</button></form> }</div> }</div>
