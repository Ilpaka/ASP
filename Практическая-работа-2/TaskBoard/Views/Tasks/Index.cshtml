@model List<TaskBoard.Services.TaskItem>
@{
    ViewData["Title"] = "Список задач";
    var status = ViewBag.Status as string ?? "all";
}

<h1>Задачи</h1>

<!-- Уровень 1 — счётчик -->
<p class="text-muted">Всего задач: <strong>@ViewBag.Total</strong>, выполнено: <strong>@ViewBag.Done</strong></p>

<a href="/tasks/create" class="btn btn-primary">Новая задача</a>

<!-- Уровень 3 — фильтр по статусу -->
<div class="btn-group mt-3 mb-2" role="group">
    <a href="/tasks?status=all" class="btn btn-sm @(status == "all" ? "btn-secondary" : "btn-outline-secondary")">Все</a>
    <a href="/tasks?status=active" class="btn btn-sm @(status == "active" ? "btn-secondary" : "btn-outline-secondary")">В работе</a>
    <a href="/tasks?status=done" class="btn btn-sm @(status == "done" ? "btn-secondary" : "btn-outline-secondary")">Готово</a>
</div>

@if (!Model.Any())
{
    <p>Пока нет задач. Создайте первую!</p>
}
else
{
    <table class="table mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Заголовок</th>
                <th>Статус</th>
                <th>Дата</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>
                        <a href="/tasks/details/@task.Id">@task.Title</a>
                    </td>
                    <td>
                        @if (task.IsDone)
                        {
                            <span class="badge bg-success">Готово</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">В работе</span>
                        }
                    </td>
                    <td>@task.CreatedAt.ToString("dd.MM HH:mm")</td>
                    <td>
                        @if (!task.IsDone)
                        {
                            <form method="post" action="/tasks/done/@task.Id" class="d-inline">
                                <input type="hidden" name="status" value="@status" />
                                <button type="submit" class="btn btn-sm btn-outline-success">✓</button>
                            </form>
                        }
                        <form method="post" action="/tasks/delete/@task.Id" class="d-inline"
                              onsubmit="return confirm('Удалить?')">
                            <input type="hidden" name="status" value="@status" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
