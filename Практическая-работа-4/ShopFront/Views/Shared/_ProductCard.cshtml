@model ShopFront.Models.Product

@{
    // === Сложный уровень: динамические классы и состояния UI через Razor ===
    var isBigSale = Model.DiscountPercent > 30;

    // Рамка: нет в наличии -> красная, большая скидка -> зелёная, иначе обычная
    var borderClass = !Model.InStock ? "border-danger"
                    : isBigSale ? "border-success"
                    : "border-light-subtle";

    // Хит продаж -> заметная тень
    var shadowClass = Model.IsHit ? "shadow" : "shadow-sm";

    // Состояния для кастомных стилей из site.css
    var stateClass = (!Model.InStock ? " is-out" : "") + (isBigSale ? " is-bigsale" : "");
}

<div class="card product-card border @borderClass @shadowClass@stateClass">

    <div class="position-relative">
        <img src="~/img/@Model.Image" class="card-img-top img-fluid product-img" alt="@Model.Name" />

        @* Бейджи состояния поверх картинки *@
        <div class="position-absolute top-0 start-0 p-2 d-flex flex-column gap-1">
            @if (!Model.InStock)
            {
                <span class="badge text-bg-danger">Нет в наличии</span>
            }
            else if (Model.IsHit)
            {
                <span class="badge text-bg-warning text-dark">ХИТ</span>
            }

            @if (isBigSale)
            {
                <span class="badge text-bg-success">Большая скидка</span>
            }
            else if (Model.DiscountPercent > 0)
            {
                <span class="badge text-bg-primary">Скидка @Model.DiscountPercent%</span>
            }
        </div>
    </div>

    <div class="card-body d-flex flex-column">
        <span class="badge text-bg-light text-muted align-self-start mb-2">@Model.Category</span>

        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text text-muted small flex-grow-1">@Model.Description</p>

        @* === Лёгкий уровень: адаптивная таблица цен ===
           На мобильных строки идут вертикально, с md — в одну строку. *@
        <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item px-0 py-1 d-md-flex justify-content-between align-items-center border-0">
                <span class="text-muted small">Цена</span>
                <span class="price-now text-primary">@Model.Price.ToString("C0")</span>
            </li>
            @if (Model.OldPrice.HasValue)
            {
                <li class="list-group-item px-0 py-1 d-md-flex justify-content-between align-items-center border-0">
                    <span class="text-muted small">Без скидки</span>
                    <span class="price-old">@Model.OldPrice.Value.ToString("C0")</span>
                </li>
                <li class="list-group-item px-0 py-1 d-md-flex justify-content-between align-items-center border-0">
                    <span class="text-muted small">Выгода</span>
                    <span class="text-success fw-semibold">
                        @((Model.OldPrice!.Value - Model.Price).ToString("C0")) (@Model.DiscountPercent%)
                    </span>
                </li>
            }
        </ul>

        @if (Model.InStock)
        {
            <form method="post" action="/Cart/Add/@Model.Id">
                <button type="submit" class="btn btn-primary w-100">В корзину</button>
            </form>
            <div class="form-text mt-1">На складе: @Model.Stock шт.</div>
        }
        else
        {
            @* Нет в наличии — кнопка заблокирована *@
            <button type="button" class="btn btn-secondary w-100" disabled>Нет в наличии</button>
            <div class="form-text mt-1">Ожидаем поступление</div>
        }
    </div>
</div>
