<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Админ-панель</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .admin-header { background:#1f2937; color:#fff; padding:12px 20px; }
        .admin-header a { color:#cbd5e1; margin-left:16px; text-decoration:none; }
        .admin-header a:hover { color:#fff; }
        .page-header { border-bottom:2px solid #e5e7eb; margin:16px 0; padding-bottom:8px; }
        .card-grid { display:flex; flex-wrap:wrap; gap:16px; }
        .metric-card { border:1px solid #e5e7eb; border-radius:10px; padding:16px; min-width:220px; flex:1; background:#fff; }
        .metric-card h4 { margin:0 0 6px; font-size:15px; color:#374151; }
        .metric-value { font-size:22px; font-weight:700; }
        .sidebar { background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px; padding:16px; }
        .neg { color:#dc2626; }
        footer.admin-footer { margin-top:32px; padding:16px 20px; color:#6b7280; border-top:1px solid #e5e7eb; }
    </style>
</head>
<body>
    <header class="admin-header d-flex justify-content-between align-items-center">
        <strong>⚙️ Админ-панель</strong>
        <nav>
            <a href="/Dashboard">Дашборд</a>
            <a href="#">Настройки</a>
        </nav>
    </header>

    <div class="container-fluid px-4">
        @* Условный заголовок страницы: своя секция PageHeader либо дефолт *@
        @if (IsSectionDefined("PageHeader"))
        {
            <div class="page-header">
                @await RenderSectionAsync("PageHeader")
            </div>
        }
        else
        {
            <div class="page-header">
                <h1>Панель управления</h1>
            </div>
        }

        @* Кастомные действия страницы (кнопка «Печать» и т.п.) — доп. уровень «Средний» *@
        @if (IsSectionDefined("Actions"))
        {
            <div class="mb-3">
                @await RenderSectionAsync("Actions")
            </div>
        }

        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="admin-footer">
        &copy; @DateTime.Now.Year Админ-панель
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
