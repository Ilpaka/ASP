<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Админ-панель</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Тема применяется до отрисовки, чтобы не было «моргания» светлой темы
        (function () {
            try {
                var t = localStorage.getItem("admin-theme");
                if (t) document.documentElement.setAttribute("data-theme", t);
            } catch (e) { }
        })();
    </script>
</head>
<body>
    <header class="topbar no-print">
        <a href="/Dashboard" class="brand">
            <span class="brand-mark">◆</span>
            <span>Админ-панель</span>
        </a>
        <nav class="topnav">
            <a href="/Dashboard" class="active">Дашборд</a>
            <a href="#">Настройки</a>
            <button type="button" class="theme-toggle" id="themeToggle" title="Сменить тему">◐</button>
        </nav>
    </header>

    <div class="shell">
        @* Условный заголовок страницы: своя секция PageHeader либо дефолт *@
        @if (IsSectionDefined("PageHeader"))
        {
            @await RenderSectionAsync("PageHeader")
        }
        else
        {
            <div class="page-head">
                <div><h1>Панель управления</h1></div>
            </div>
        }

        @* Кастомные действия страницы (кнопка «Печать» и т.п.) — доп. уровень «Средний» *@
        @if (IsSectionDefined("Actions"))
        {
            <div class="no-print" style="margin-bottom:18px">
                @await RenderSectionAsync("Actions")
            </div>
        }

        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        &copy; @DateTime.Now.Year Админ-панель
    </footer>

    <script>
        (function () {
            var btn = document.getElementById("themeToggle");
            if (!btn) return;
            btn.addEventListener("click", function () {
                var root = document.documentElement;
                var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
                root.setAttribute("data-theme", next);
                try { localStorage.setItem("admin-theme", next); } catch (e) { }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
