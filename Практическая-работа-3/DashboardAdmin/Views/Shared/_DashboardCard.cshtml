@model DashboardAdmin.Models.DashboardCard

@* Partial-представление карточки. Только типизированная модель, ViewBag запрещён. *@

@functions {
    // Текст тренда (метод из @functions внутри partial)
    string GetTrendLabel(DashboardAdmin.Models.Trend t) => t switch
    {
        DashboardAdmin.Models.Trend.Up => "Рост",
        DashboardAdmin.Models.Trend.Down => "Снижение",
        _ => "Стабильно"
    };

    string GetTrendIcon(DashboardAdmin.Models.Trend t) => t switch
    {
        DashboardAdmin.Models.Trend.Up => "↑",
        DashboardAdmin.Models.Trend.Down => "↓",
        _ => "→"
    };

    string GetTrendCss(DashboardAdmin.Models.Trend t) => t switch
    {
        DashboardAdmin.Models.Trend.Up => "t-up",
        DashboardAdmin.Models.Trend.Down => "t-down",
        _ => "t-stable"
    };

    // Доп. уровень «Лёгкий»: классификация значения
    string GetValueClass(decimal value)
    {
        if (value < 0) return "Отрицательное";
        if (value < 1000) return "Низкое";
        if (value <= 10000) return "Среднее";
        return "Высокое";
    }

    // Заполнение полосы = «вес» категории значения. Partial знает только свою карточку
    // (ViewBag здесь запрещён), поэтому шкала строится от тех же порогов, что и GetValueClass.
    int GetBarPercent(decimal value) => GetValueClass(value) switch
    {
        "Низкое" => 30,
        "Среднее" => 65,
        "Высокое" => 100,
        _ => 100 // Отрицательное — полная полоса, но красная
    };
}

<a class="metric-card @GetTrendCss(Model.Trend)" href="/Dashboard/Details/@Model.Id">
    <div class="card-top">
        <h4 class="card-title">@Model.Title</h4>
        <span class="trend-pill @GetTrendCss(Model.Trend)">
            @GetTrendIcon(Model.Trend) @GetTrendLabel(Model.Trend)
        </span>
    </div>

    <div class="card-value @(Model.Value < 0 ? "neg" : "")">
        @Model.Value.ToString("N1")<span class="unit">@Model.Unit</span>
    </div>

    <div class="bar">
        <i class="@GetTrendCss(Model.Trend)" style="width:@GetBarPercent(Model.Value)%"></i>
    </div>

    <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:9px">
        <span class="badge-soft @(Model.Value < 0 ? "badge-danger" : "")">@GetValueClass(Model.Value)</span>
        @if (Model.Value < 0)
        {
            <span class="badge-soft badge-danger">Отрицательное значение</span>
        }
    </div>

    <p class="card-desc">@Model.Description</p>
</a>
