@model List<CatalogAjax.Models.Product>
@{
    ViewData["Title"] = "Админ-панель";
}

<h1 class="page-title">Админ-панель</h1>
<p class="page-subtitle">Сводка по каталогу и складу</p>

@* Плитки статистики на сетке Bootstrap *@
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Товаров</div>
                <div class="fs-3 fw-bold">@ViewBag.Total</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100 border-danger">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Нет в наличии</div>
                <div class="fs-3 fw-bold text-danger">@ViewBag.OutOfStock</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Хитов продаж</div>
                <div class="fs-3 fw-bold text-warning">@ViewBag.Hits</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100 border-success">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Скидка &gt; 30%</div>
                <div class="fs-3 fw-bold text-success">@ViewBag.BigDiscounts</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-semibold">Стоимость складских остатков</span>
        <span class="price-now text-primary">@(((decimal)ViewBag.StockValue).ToString("C0"))</span>
    </div>
</div>

@* Таблица товаров — на мобильных прокручивается по горизонтали *@
<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">Товары</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Название</th>
                    <th>Категория</th>
                    <th class="text-end">Цена</th>
                    <th class="text-end">Скидка</th>
                    <th class="text-end">Остаток</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(!p.InStock ? "table-danger" : "")">
                        <td class="text-muted">@p.Id</td>
                        <td class="fw-semibold">@p.Name</td>
                        <td><span class="badge text-bg-light text-muted">@p.Category</span></td>
                        <td class="text-end">@p.Price.ToString("C0")</td>
                        <td class="text-end">
                            @if (p.DiscountPercent > 0)
                            {
                                <span class="badge @(p.DiscountPercent > 30 ? "text-bg-success" : "text-bg-primary")">
                                    @p.DiscountPercent%
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">@p.Stock</td>
                        <td>
                            @if (!p.InStock)
                            {
                                <span class="badge text-bg-danger">Нет в наличии</span>
                            }
                            else if (p.IsHit)
                            {
                                <span class="badge text-bg-warning text-dark">ХИТ</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">В продаже</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
