@model CatalogAjax.Models.CartViewModel
@{
    ViewData["Title"] = "Корзина";
}

<h1 class="page-title">Корзина</h1>
<p class="page-subtitle">Проверьте заказ перед оформлением</p>

@* === Задание 4: alert через Bootstrap === *@
@if (TempData["Added"] is string addedName)
{
    @* Товар только что добавлен *@
    @await Html.PartialAsync("_AlertPartial", new CatalogAjax.Models.AlertMessage
    {
        Type = "success",
        Text = $"Товар «{addedName}» добавлен в корзину"
    })
}

@if (!Model.Items.Any())
{
    @* Корзина пуста *@
    @await Html.PartialAsync("_AlertPartial", new CatalogAjax.Models.AlertMessage
    {
        Type = "warning",
        Text = "Корзина пуста"
    })

    <div class="text-center py-4">
        <p class="text-muted">Добавьте товары из каталога, чтобы оформить заказ.</p>
        <a href="/Catalog" class="btn btn-primary">Перейти в каталог</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-semibold">
                    Товары в заказе (@Model.TotalCount шт.)
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <div class="fw-semibold">@item.Name</div>
                                <div class="text-muted small">
                                    @item.Price.ToString("C0") × @item.Quantity шт.
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold">@item.Sum.ToString("C0")</span>
                                <form method="post" action="/Cart/Remove/@item.ProductId">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            title="Убрать одну штуку">−</button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Итого</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Позиций</span>
                        <span>@Model.Items.Count</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Товаров</span>
                        <span>@Model.TotalCount шт.</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-semibold">К оплате</span>
                        <span class="price-now text-primary">@Model.TotalAmount.ToString("C0")</span>
                    </div>

                    @* === Задание 5: кнопка вызова модального окна === *@
                    <button type="button" class="btn btn-checkout w-100"
                            data-bs-toggle="modal" data-bs-target="#confirmOrderModal">
                        Оформить заказ
                    </button>

                    <a href="/Catalog" class="btn btn-link w-100 mt-2">Продолжить покупки</a>
                </div>
            </div>
        </div>
    </div>

    @* === Задание 5: модальное окно «Подтверждение заказа» === *@
    <div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-labelledby="confirmOrderLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmOrderLabel">Подтверждение заказа</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Вы уверены, что хотите оформить заказ на сумму
                        <strong>@Model.TotalAmount.ToString("C0")</strong>?
                    </p>
                    <ul class="list-group mb-3">
                        @foreach (var item in Model.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.Name <span class="text-muted small">× @item.Quantity</span></span>
                                <span class="fw-semibold">@item.Sum.ToString("C0")</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between bg-light">
                            <span class="fw-semibold">Итого</span>
                            <span class="fw-bold">@Model.TotalAmount.ToString("C0")</span>
                        </li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <form method="post" action="/Cart/Checkout">
                        <button type="submit" class="btn btn-checkout">Подтвердить</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
