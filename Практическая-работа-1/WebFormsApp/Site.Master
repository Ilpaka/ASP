<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebFormsApp.SiteMaster" %>
<!DOCTYPE html>
<html lang="ru">
<head runat="server">
    <meta charset="utf-8" />
    <title>Практическая работа №1 — ASP.NET Web Forms</title>
    <style type="text/css">
        body { font-family: Segoe UI, Arial, sans-serif; margin: 24px; color: #222; }
        h1 { font-size: 22px; }
        h2 { font-size: 17px; margin-top: 24px; }
        .block { border: 1px solid #ddd; border-radius: 6px; padding: 12px; margin: 8px 0; }
        .result { font-weight: bold; color: #0b6; }
        input, select { padding: 4px 6px; margin: 2px; }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="mainForm" runat="server">
        <h1>Практическая работа №1: событийная модель и ViewState</h1>
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </form>
</body>
</html>
