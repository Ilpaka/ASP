<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Аналитика</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">A</span> Аналитика</a>
        <div class="topbar-right"><span class="live-dot"></span> Данные обновляются в реальном времени <span class="avatar">И</span></div>
    </header>
    <main class="page-shell">@RenderBody()</main>
    <footer class="footer">Учебный проект · Razor + Vanilla JavaScript + Fetch API</footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
